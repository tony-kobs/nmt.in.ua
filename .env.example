# MySQL connection for server-side database access.
# Copy to .env.local (never commit real values) and fill in real credentials.
NEXT_PUBLIC_SITE_URL=https://nmt.in.ua

DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Optional: connection pool size (default 10).
DB_CONNECTION_LIMIT=10
# Optional: connect timeout in ms when opening a socket (default 15000).
DB_CONNECT_TIMEOUT_MS=15000
# Optional: how many idle connections the pool keeps (default 4).
DB_MAX_IDLE=4
# Optional: how long an idle connection is kept before recycling (default 30000).
# Keep this below the MySQL server's `wait_timeout`, otherwise the pool hands out
# sockets the server has already closed and requests fail with ECONNRESET.
DB_IDLE_TIMEOUT_MS=30000
# Optional: only `ping` a pooled socket that sat idle this long (default 10000).
# A ping costs a full round trip; a socket handed back seconds ago is still alive.
# Keep it below DB_IDLE_TIMEOUT_MS. 0 = ping before every query (old behaviour).
DB_PING_AFTER_IDLE_MS=10000

# Shared secret required as `Authorization: Bearer <value>` on POST /api/import.
# Required — with this unset, the endpoint rejects every request (fails closed).
# Generate a long random value (e.g. `openssl rand -hex 32`); never commit a real value.
CONTENT_IMPORT_API_KEY=

# Shared secret for POST /api/admin/sessions (mentor session assignment).
# Required — with this unset, the endpoint rejects every request (fails closed).
ADMIN_API_KEY=

# HMAC secret for signed session cookies (`nmt_session`). Required in production.
# Generate: `openssl rand -hex 32`
# Do not reuse ADMIN_API_KEY or CONTENT_IMPORT_API_KEY here.
SESSION_SECRET=

# WayForPay acquiring for paid teacher registration (`/register/teacher`).
# Put real credentials only in `.env.local` (dev) or hosting `.env.production`.
# Never commit them. GitHub Secrets are not used for these values.
# Empty account/secret = scaffold: Ukrainian “оплату ще не налаштовано”, no checkout.
# Sandbox (official WayForPay docs): WAYFORPAY_MERCHANT_ACCOUNT=test_merch_n1
# and the matching SecretKey from the merchant cabinet — local `.env` only.
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET_KEY=
# Optional. Domain registered in the WayForPay merchant cabinet.
# Default: hostname of NEXT_PUBLIC_SITE_URL (nmt.in.ua).
# WAYFORPAY_MERCHANT_DOMAIN=nmt.in.ua
# Optional. Default: https://secure.wayforpay.com/pay
# WAYFORPAY_PAY_URL=https://secure.wayforpay.com/pay

# Optional: how many reverse-proxy hops sit in front of Node (0–5).
# Used for rate-limit IP: we never trust the leftmost X-Forwarded-For (clients
# can spoof it). Prefer that the edge sets X-Real-IP from $remote_addr.
# Default: 1 in production, 0 in development (ignore XFF).
# TRUSTED_PROXY_HOPS=1

# Optional: enable one-click demo logins in production (default: off when NODE_ENV=production).
# Dev still shows demo buttons. Never enable on a public production site.
# ALLOW_DEMO_LOGIN=1

# Optional: teacher registration “Оплата пройшла” test button.
# Default on in development and when WAYFORPAY_MERCHANT_ACCOUNT=test_merch_n1.
# Hard-off in production with a live merchant, even if this is 1.
# Set 0 to hide it locally. Never set 1 on the public site with live keys.
# TEACHER_PAYMENT_TEST_BYPASS=1

# Optional: require TLS for the MySQL pool (set to 1 on hosts that support it).
# DB_SSL=1

# Max request body size accepted by server.js (bytes). Must stay at or above
# the application's own declared-body limit, MAX_REQUEST_BODY_BYTES (8 MiB,
# see src/modules/content-import/schema.ts), which already covers multipart
# boundaries/headers on top of the 5 MiB MAX_TOTAL_UPLOAD_BYTES file-content
# limit. See README.md.
MAX_BODY_BYTES=8388608
