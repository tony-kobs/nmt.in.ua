# Локальний приклад для nmt.in.ua. Скопіюй у .env.local і не коміть його.
# Тут немає прод-ключів. Порожнє значення = сервіс вимкнений або бере дефолт з коду.
# Повний шлях від клону до сайту: docs/LOCAL_DEV.md
#
# «Локально обов'язково» — без цього кабінет не відкриється.
# «Локально ні» — для npm run dev не став. Це CI, хостинг або службовий скрипт.

# --- Сайт -----------------------------------------------------------------
# Канонічна адреса. Інлайниться на `next build`. У листах не використовується.
# Локально не обов'язково. Порожнє в коді → https://nmt.in.ua (src/constants/seo.ts).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Origin листів і редіректів. Читається в рантаймі, не на збірці.
# Локально не обов'язково. Порожнє в development → http://localhost:3000.
# На проді localhost ігнорується, лишається https://nmt.in.ua.
SITE_URL=http://localhost:3000

# Запасний origin листів, якщо SITE_URL порожній. Локально не обов'язково.
MAIL_SITE_URL=http://localhost:3000

# --- MySQL (локально обов'язково) -----------------------------------------
# Значення збігаються з docker-compose.yml. Це локальна база, не хостинг.
# Порожній рядок код вважає відсутньою змінною (src/lib/db/mysql.ts).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=nmt
DB_PASSWORD=nmt-local
DB_NAME=nmt_local

# Розмір пулу. Локально не обов'язково. Дефолт 10.
DB_CONNECTION_LIMIT=10
# Таймаут з'єднання, мс. Локально не обов'язково. Дефолт 15000.
DB_CONNECT_TIMEOUT_MS=15000
# Скільки простоюючих з'єднань тримати. Локально не обов'язково. Дефолт 4.
DB_MAX_IDLE=4
# Скільки мс тримати простійне з'єднання. Локально не обов'язково. Дефолт 30000.
# Має бути менше за wait_timeout сервера MySQL.
DB_IDLE_TIMEOUT_MS=30000
# Після скількох мс простою пінити сокет перед запитом. Локально не обов'язково.
# Дефолт 10000. 0 = пінг перед кожним запитом.
DB_PING_AFTER_IDLE_MS=10000
# TLS до MySQL. Локально не обов'язково. Лише значення 1 вмикає TLS. Порожньо = без TLS.
DB_SSL=

# --- Сесія ---------------------------------------------------------------
# HMAC для cookie nmt_session. Локально не обов'язково: у development код
# підставляє той самий слабкий рядок, що нижче (src/modules/auth/sessionToken.ts).
# На проді без свого секрету логін падає. Згенеруй окремий: openssl rand -hex 32.
# Не копіюй сюди ADMIN_API_KEY чи ключ імпорту. Цей рядок не для хостингу.
SESSION_SECRET=dev-insecure-session-secret-change-me

# --- Листи Brevo ----------------------------------------------------------
# Транзакційні листи (підтвердження, скидання пароля).
# Локально не обов'язково. Порожньо в development: текст листа пишеться в консоль
# як [mail:log], реєстрація не падає. На проді без ключа відправка закрита.
# Свій тестовий ключ — лише з власного акаунта Brevo, не з продакшену.
BREVO_API_KEY=
# Відправник. Локально не обов'язково. Дефолт: NMT.in.ua <noreply@nmt.in.ua>
# Має бути на домені, який ти підтвердив у своєму Brevo.
MAIL_FROM=

# --- Telegram -------------------------------------------------------------
# Бот. Локально не обов'язково. Без токена і username канал вимкнений:
# webhook відповідає 503, сайт і кабінет працюють.
# Свій тестовий бот — BotFather, не прод-бот nmt.in.ua. Деталі в docs/LOCAL_DEV.md.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# Секрет заголовка X-Telegram-Bot-Api-Secret-Token. Локально не обов'язково.
# Порожньо = webhook не приймає оновлення. Свій: openssl rand -hex 32.
TELEGRAM_WEBHOOK_SECRET=
# Чат команди для звернень. Локально не обов'язково. Порожньо = звернення
# лишаються в адмінці, у Telegram не йдуть.
TELEGRAM_SUPPORT_CHAT_ID=
# Захист POST розсилки задач у Telegram. Локально не обов'язково (лише прод/CI).
# Порожньо = ендпоінт відповідає 401.
TELEGRAM_NOTIFICATIONS_TRIGGER_SECRET=

# --- Крон марафону --------------------------------------------------------
# Bearer для HTTP-крону статистики і розсилки. Локально не обов'язково.
# Порожньо = запит отримує 401. Процес dev крон сам не крутить, доки
# MARATHON_SCHEDULER не `on`.
MARATHON_CRON_SECRET=
# Секрет посилання відписки. Локально не обов'язково.
# Порожньо = бере SESSION_SECRET, інакше MARATHON_CRON_SECRET.
MARATHON_UNSUBSCRIBE_SECRET=
# Тік розсилки всередині процесу. Локально не обов'язково.
# Порожньо: у development вимкнено, на проді увімкнено.
# on = примусово увімкнути, off = примусово вимкнути.
MARATHON_SCHEDULER=

# --- Службові API ---------------------------------------------------------
# Bearer для POST /api/import. Локально не обов'язково для кабінету.
# Порожньо = кожен запит 401 (закрито). Свій локальний: openssl rand -hex 32.
CONTENT_IMPORT_API_KEY=
# Bearer для POST /api/admin/sessions. Локально не обов'язково для кабінету.
# Порожньо = кожен запит 401. Не той самий рядок, що SESSION_SECRET.
ADMIN_API_KEY=

# --- WayForPay ------------------------------------------------------------
# Оплата викладача. Локально не обов'язково. Порожній рахунок = оплата не
# налаштована, сторінка реєстрації не падає. У git ключі не класти.
# Пісочниця з документації WayForPay (лише локально, якщо знову вмикаєте еквайринг):
# WAYFORPAY_MERCHANT_ACCOUNT=test_merch_n1
WAYFORPAY_MERCHANT_ACCOUNT=
WAYFORPAY_MERCHANT_SECRET_KEY=
# Домен мерчанта. Локально не обов'язково. Дефолт — хост NEXT_PUBLIC_SITE_URL.
WAYFORPAY_MERCHANT_DOMAIN=
# Адреса платіжної сторінки. Локально не обов'язково.
# Дефолт: https://secure.wayforpay.com/pay
WAYFORPAY_PAY_URL=
# Тестова кнопка «Оплата пройшла». Локально не обов'язково.
# У development кнопка і так увімкнена. На проді з живим мерчантом лишається вимкненою.
TEACHER_PAYMENT_TEST_BYPASS=

# --- Генерація схожих завдань (адмінка) --------------------------------
# Порожній LLM_API_KEY ховає кнопку «Згенерувати схожі». Ключ у git не класти.
# LLM_PROVIDER: openai (типово, сумісний chat/completions), openrouter, groq,
# together або anthropic. Свій шлюз: LLM_BASE_URL=https://host/v1
# LLM_MODEL — назва моделі. Порожньо: gpt-4o-mini або claude-3-5-haiku-latest.
LLM_API_KEY=
LLM_PROVIDER=
LLM_MODEL=
LLM_BASE_URL=

# --- Проксі і тіло запиту -------------------------------------------------
# Скільки довірених хопів у X-Forwarded-For (0–5). Локально не обов'язково.
# Дефолт: 0 у development, 1 на проді.
TRUSTED_PROXY_HOPS=
# Ліміт тіла в server.js, байти. Локально не обов'язково. Дефолт 8388608.
# npm run dev цей файл не читає; його читає npm start.
MAX_BODY_BYTES=8388608

# --- Лише прод / збірка. У .env.local для навчання не став ---------------
# base64 на 32 байти для Server Actions. Ставить деплой, не студент.
# NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Адреса, яку панель хостингу кладе в процес. Локально next сам слухає :3000.
# HOST=
# HOSTNAME=
# PORT=
# NODE_ENV ставить next (development / production). Не прописуй.
# TMPDIR ставить server.js на хості. Локально не став.
# NEXT_RUNTIME і NEXT_PHASE ставить сам Next. Не прописуй.

# --- Скрипти і CI. Для npm run dev не потрібні ---------------------------
# Журнал релізу (scripts/record-changelog.mjs), їх задає GitHub Actions:
# TARGET, PR_BODY, PR_TITLE, PR_NUMBER, PR_URL, PR_AUTHOR, MERGED_AT, COMMENT_PATH
# Скріншоти scripts/shot.mjs:
# CHROME_PATH, SHOT_BASE, SHOT_OUT, SHOT_DEMO, SHOT_LOGIN, SHOT_PASSWORD, TEMP
# Окрема база для тесту бекфілу пар НМТ. Порожньо = тест пропускається.
# NMT_MATCH_TEST_DATABASE=
# TZ — лише якщо скрипт тестів підміняє зону. Не став.
# PATH — шлях ОС. Не став.
#
# Секрети деплою читає scripts/deploy-hosting.sh, не сайт. У .env.local не класти:
# HOSTING_SSH_KEY, ADM_TOOLS_TOKEN, ADM_TOOLS_HOST_ID, GITHUB_SHA, GITHUB_WORKSPACE,
# REMOTE_HOST, REMOTE_USER, REMOTE_SITE, SSH_KEY, RELEASE_ID
